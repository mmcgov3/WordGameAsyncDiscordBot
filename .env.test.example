# Copy this file to `.env.test` and fill in the values.
#   cp .env.test.example .env.test
# `.env.test` is gitignored, so your token stays out of version control.

# Your Discord bot token (same one used in production / your GitHub secret).
DISCORD_BOT_TOKEN=your-bot-token-here

# The ID of your private "testing" channel.
TEST_CHANNEL_ID=123456789012345678

# Throwaway totals file for tests. Must NOT be a real one
# (totals_private.json / totals_public.json are rejected by the script).
TEST_TOTALS_FILE=totals_test.json

# NY calendar day to process (YYYY-MM-DD). The day you posted your test
# messages. Leave blank to default to "today" in New York.
PROCESS_DATE=
